{
  "id": "tile-board",
  "name": "Tile Board",
  "runtime": {
    "engine": "@game-maker/engine",
    "web": "@game-maker/web"
  },
  "configSchema": {
    "required": ["id", "name", "templateId", "board", "pieceTypes", "initialPieces"],
    "optional": ["items", "run"],
    "features": ["tileFlip", "runMode"],
    "notes": {
      "run": "Required when features.runMode is true: { heroPieceId, startPosition, maxHp, baseAttack }",
      "items": "Optional ItemDefinition[] with attackBonus / maxHpBonus",
      "tileEffects": "TileTypeDefinition.effect may be empty|wall|trap|enemy|powerup|goal"
    }
  }
}
